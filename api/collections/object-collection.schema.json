{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broadinstitute.github.io/claims-repository/api/collections/object-collection.schema.json",
  "title": "Object collection manifest",
  "description": "A collection whose releases are built from deposits of DAPPER objects (kind: objects), not from result files. Each release is opened, filled by one or more deposits naming the collection, and closed. The manifest says which DAPPER classes it holds, which slots queries filter and order on (fields) and follow (links), its own vocabulary files, and its query templates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection",
    "kind",
    "title",
    "methods",
    "dapper_profile",
    "object_kinds",
    "queries"
  ],
  "properties": {
    "collection": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "kind": {
      "const": "objects"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dapper_profile": {
      "type": "string",
      "minLength": 1
    },
    "object_kinds": {
      "type": "object",
      "minProperties": 1,
      "description": "DAPPER class name -> what queries may read of it. Objects of other classes may be deposited into the release too; they are members, but no query anchors on them.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fields"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "field name -> the slot whose value(s) it indexes (a string, number, or list of them).",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot"
              ],
              "properties": {
                "slot": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "links": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "link name -> a slot holding dapper ids of other objects, which a query can follow.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot"
              ],
              "properties": {
                "slot": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "mappings": {
      "type": "object",
      "description": "Per field, a TSV mapping keys a query may pass to the field's ids (key, id, label, and attributes). The collection's own vocabulary; the service reads no registry.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "xrefs": {
      "type": "object",
      "description": "Per mapped field, an SSSOM-style TSV of the ids' cross-references.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
