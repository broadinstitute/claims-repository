<mxfile host="claims-repository" modified="2026-11-25" agent="claude" version="24.0.0">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="arch-1" value="&lt;b&gt;Claims repository: where the data lives and how it moves&lt;/b&gt; (QA, 2026-11-25). Result files stay in the data owner's S3; each release's query index (Parquet) sits in a bucket next to them; Aurora MySQL keeps only bookkeeping and the claims actually served. Numbered arrows: &lt;font color='#9673a6'&gt;&lt;b&gt;L&lt;/b&gt; sign-in&lt;/font&gt;, &lt;font color='#1f6feb'&gt;&lt;b&gt;P&lt;/b&gt; publish&lt;/font&gt;, &lt;font color='#2e7d32'&gt;&lt;b&gt;Q&lt;/b&gt; query&lt;/font&gt;, &lt;font color='#d79b00'&gt;&lt;b&gt;C&lt;/b&gt; cache fill&lt;/font&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1880" height="50" as="geometry"/></mxCell>
        <mxCell id="arch-2" value="Data owner's AWS (S3): data stays here" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;dashed=0;container=0;fillColor=#ffe6cc;strokeColor=#d79b00;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="440" height="520" as="geometry"/></mxCell>
        <mxCell id="arch-3" value="Publishing machine (your server or laptop)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;dashed=0;container=0;fillColor=#f5f5f5;strokeColor=#666666;fillOpacity=50;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="440" height="520" as="geometry"/></mxCell>
        <mxCell id="arch-4" value="Admin console (Vercel, Next.js)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;dashed=0;container=0;fillColor=#e1d5e7;strokeColor=#9673a6;fillOpacity=50;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="420" height="230" as="geometry"/></mxCell>
        <mxCell id="arch-5" value="Clients" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;dashed=0;container=0;fillColor=#f5f5f5;strokeColor=#666666;fillOpacity=50;" vertex="1" parent="1"><mxGeometry x="1460" y="80" width="460" height="230" as="geometry"/></mxCell>
        <mxCell id="arch-6" value="QA service: AWS ECS Fargate (dig-service-platform) · api-qa.hugeampkpnbi.org/api/claims behind ALB + nginx · 0.5 vCPU, 2 GB, Spot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;dashed=0;container=0;fillColor=#d5e8d4;strokeColor=#82b366;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="520" y="650" width="900" height="610" as="geometry"/></mxCell>
        <mxCell id="arch-7" value="Aurora MySQL · cyaka_claims_repository_v2 (shared by QA and prod)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;dashed=0;container=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fillOpacity=35;" vertex="1" parent="1"><mxGeometry x="1460" y="650" width="460" height="610" as="geometry"/></mxCell>
        <mxCell id="arch-8" value="&lt;b&gt;Result files&lt;/b&gt; (NDJSON), never copied&lt;br&gt;s3://dig-pigean-paper-regression-2/out/falcon/&lt;br&gt;&amp;nbsp;&amp;nbsp;combined_gene_stats / combined_gene_set_stats /&lt;br&gt;&amp;nbsp;&amp;nbsp;gene_gene_set_stats, per library and trait&lt;br&gt;Every claim cites one by sha256 + byte range." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="400" height="150" as="geometry"/></mxCell>
        <mxCell id="arch-9" value="&lt;b&gt;Release index&lt;/b&gt; (Parquet), one folder per dataset&lt;br&gt;s3://cyaka-claims-index-test/&amp;lt;collection&amp;gt;/datasets/&amp;lt;dataset id&amp;gt;/&lt;br&gt;&amp;nbsp;&amp;nbsp;rows.parquet · metrics.parquet · edges.parquet · counts.json&lt;br&gt;About 0.2 MB per PIGEAN trait (9 MB for 50; ~180 MB for 1,444).&lt;br&gt;Built by the CLI. QA records each file's sha256 and S3 version&lt;br&gt;and refuses a file changed after publishing." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="400" height="170" as="geometry"/></mxCell>
        <mxCell id="arch-10" value="&lt;b&gt;Planned:&lt;/b&gt; combined release files&lt;br&gt;.../releases/&amp;lt;release&amp;gt;/rows · metrics · edges.parquet&lt;br&gt;(3 files per release: faster cross-trait queries and startup fill)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="arch-11" value="&lt;b&gt;claims CLI&lt;/b&gt; (bin/claims)&lt;br&gt;&lt;b&gt;claims login&lt;/b&gt;: device-code sign-in (L)&lt;br&gt;&lt;b&gt;claims release plan&lt;/b&gt;: list the S3 files, write releases/&amp;lt;v&amp;gt;.yaml&lt;br&gt;&lt;b&gt;claims release publish --api qa --index-to s3://…&lt;/b&gt; (P):&lt;br&gt;&amp;nbsp;&amp;nbsp;read each file, check sha256, check every row&lt;br&gt;&amp;nbsp;&amp;nbsp;build its Parquet index with DuckDB&lt;br&gt;&amp;nbsp;&amp;nbsp;upload it, then register it with QA&lt;br&gt;Collection definitions: kpn-dapper-toolkit/collections/&amp;lt;handle&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="arch-12" value="&lt;b&gt;Local deployment&lt;/b&gt; (optional, for checking before QA)&lt;br&gt;SQLite control database + Parquet index on disk&lt;br&gt;&lt;b&gt;claims serve&lt;/b&gt;: the same API locally (&lt;b&gt;DuckDB&lt;/b&gt;)&lt;br&gt;Also keeps the files' sha256s; stages indexes" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="590" y="340" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="arch-13" value="&lt;b&gt;~/.config/claims/credentials.json&lt;/b&gt; (mode 0600)&lt;br&gt;the publisher token (clp_…, 30 days), saved by&lt;br&gt;claims login; or CLAIMS_TOKEN for unattended runs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="590" y="480" width="350" height="90" as="geometry"/></mxCell>
        <mxCell id="arch-14" value="&lt;b&gt;/admin/device&lt;/b&gt;: approve a CLI sign-in code&lt;br&gt;&lt;b&gt;Keys → CLI sessions&lt;/b&gt;: list, revoke tokens&lt;br&gt;Google sign-in; admins = ADMIN_EMAILS&lt;br&gt;Calls the admin API with a signed assertion&lt;br&gt;(CLAIMS_ADMIN_GATEWAY_SECRET)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="380" height="170" as="geometry"/></mxCell>
        <mxCell id="arch-15" value="&lt;b&gt;Agents, apps, the portal, people&lt;/b&gt;&lt;br&gt;&lt;b&gt;GraphQL /v1/graphql&lt;/b&gt;: the main query surface&lt;br&gt;&amp;nbsp;&amp;nbsp;rows(…){ claim(key) joined(…){ edge{claim} row{claim} } }&lt;br&gt;REST /v1/collections/{c}/queries/{q}:run (query templates)&lt;br&gt;/v1/objects/{id}: any stored DAPPER object" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="120" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="arch-16" value="&lt;b&gt;FastAPI app&lt;/b&gt; (service/app.py)&lt;br&gt;/v1/graphql · /v1/collections/… queries&lt;br&gt;/v1/publish/* (Bearer publisher token)&lt;br&gt;/v1/auth/* (device-code sign-in)&lt;br&gt;/v1/admin/api/* (console assertions only)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="700" width="400" height="140" as="geometry"/></mxCell>
        <mxCell id="arch-17" value="&lt;b&gt;Publish API&lt;/b&gt; (publish_api.py)&lt;br&gt;checks the collection files sent (bundle)&lt;br&gt;reads each dataset's index into the cache, checks sha256&lt;br&gt;recomputes every id, metric, edge, gene set from the values&lt;br&gt;builds the Dataset / File / release records itself&lt;br&gt;records who published (no result rows stored)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="870" width="400" height="150" as="geometry"/></mxCell>
        <mxCell id="arch-18" value="&lt;b&gt;Query engine&lt;/b&gt;&lt;br&gt;REST: serve.run_plan · GraphQL: rows.py&lt;br&gt;anchor → joins → claims, each list answered at once&lt;br&gt;&lt;b&gt;envelopes()&lt;/b&gt;: every claim of a response in ~5 batched reads&lt;br&gt;&lt;b&gt;claim engine&lt;/b&gt; (engine.py): renders claims from rows +&lt;br&gt;mint contexts, DAPPER-ID-1 ids (CPU)&lt;br&gt;&lt;i&gt;store.get_store picks a store per dataset ↓&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="700" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="arch-19" value="&lt;b&gt;BucketStore&lt;/b&gt;&lt;br&gt;(bucket-indexed releases)&lt;br&gt;&lt;b&gt;DuckDB&lt;/b&gt; over the local cache:&lt;br&gt;anchor, joins,&lt;br&gt;gene-set groups" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="980" y="880" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="arch-20" value="&lt;b&gt;SqlStore&lt;/b&gt;&lt;br&gt;(releases in MySQL, e.g. pigean)&lt;br&gt;&lt;b&gt;SQL&lt;/b&gt; over result_rows,&lt;br&gt;result_metrics,&lt;br&gt;result_edges" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200" y="880" width="200" height="150" as="geometry"/></mxCell>
        <mxCell id="arch-21" value="&lt;b&gt;Local index cache&lt;/b&gt; /tmp/claims-index-cache&lt;br&gt;the task's own disk; a dataset enters it only after&lt;br&gt;its files match the sha256 recorded at publish&lt;br&gt;emptied when the task is replaced (Spot)&lt;br&gt;&lt;i&gt;planned: filled at startup&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="1060" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="arch-22" value="&lt;b&gt;Bookkeeping&lt;/b&gt;&lt;br&gt;collections, collection_releases (published_by)&lt;br&gt;release_datasets, dataset_dimensions, dataset_files&lt;br&gt;mint_contexts, release_mint_contexts&lt;br&gt;&lt;b&gt;dataset_indexes&lt;/b&gt;: where each index is + sha256s&lt;br&gt;publish_bundles (collection files sent)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="700" width="420" height="170" as="geometry"/></mxCell>
        <mxCell id="arch-23" value="&lt;b&gt;Served claims&lt;/b&gt; (written the first time each is served)&lt;br&gt;dapper_objects (claims, propositions, evidence…)&lt;br&gt;result_claims, object_refs, object_text" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="890" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="arch-24" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;publisher_tokens, device_codes, admin_auth_events, api_keys" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="1020" width="420" height="80" as="geometry"/></mxCell>
        <mxCell id="arch-25" value="&lt;b&gt;Result rows of MySQL-backed releases&lt;/b&gt;&lt;br&gt;result_rows, result_metrics, result_edges&lt;br&gt;(the current &lt;i&gt;pigean&lt;/i&gt;: ~23M edges, ~12 GB)&lt;br&gt;Bucket-indexed releases store none here." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="1120" width="420" height="120" as="geometry"/></mxCell>
        <mxCell id="arch-26" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;dashed=0;container=0;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="440" height="600" as="geometry"/></mxCell>
        <mxCell id="arch-27" value="MySQL (Aurora)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="arch-28" value="DuckDB / Parquet" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="200" y="690" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="arch-29" value="S3" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="arch-30" value="Service code" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="60" y="734" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="arch-31" value="Console" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="200" y="734" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="arch-32" value="Planned" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="340" y="734" width="120" height="34" as="geometry"/></mxCell>
        <mxCell id="arch-33" value="&lt;font color='#9673a6'&gt;&lt;b&gt;Sign-in&lt;/b&gt;&lt;/font&gt;&lt;br&gt;L1 claims login asks QA for a code (POST /v1/auth/device)&lt;br&gt;L2 an admin approves the code in the console&lt;br&gt;L3 the CLI receives a 30-day token and saves it&lt;br&gt;&lt;br&gt;&lt;font color='#1f6feb'&gt;&lt;b&gt;Publish&lt;/b&gt;&lt;/font&gt;&lt;br&gt;P1 the CLI reads each result file from S3, checks its sha256&lt;br&gt;P2 builds the dataset's Parquet index, uploads it to the index bucket&lt;br&gt;P3 registers it with QA: :begin, PUT dataset, :finish (token)&lt;br&gt;P4 QA reads the index, checks sha256, recomputes every id&lt;br&gt;P5 QA records bookkeeping only (no result rows)&lt;br&gt;&lt;br&gt;&lt;font color='#2e7d32'&gt;&lt;b&gt;Query&lt;/b&gt;&lt;/font&gt; (page 2 has every step)&lt;br&gt;Q1 GraphQL or REST request · Q2 to the query engine&lt;br&gt;Q3 release, datasets, mint contexts from MySQL (batched)&lt;br&gt;Q4 rows from the dataset's store: DuckDB or MySQL&lt;br&gt;Q5 claims served in one batch; new ones stored after&lt;br&gt;Q6 the response: claims with evidence pointing at the&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;result files' bytes (nothing reads them at query time)&lt;br&gt;&lt;br&gt;&lt;font color='#d79b00'&gt;&lt;b&gt;C&lt;/b&gt;&lt;/font&gt; cache fill: a dataset's index enters QA's cache on first&lt;br&gt;use, sha256-checked (planned: at startup)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="410" height="460" as="geometry"/></mxCell>
        <mxCell id="arch-34" value="L1 · L3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-11" target="arch-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-35" value="L2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-14" target="arch-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1115" y="610"/><mxPoint x="740" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="arch-36" value="P1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1f6feb;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-8" target="arch-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-37" value="P2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1f6feb;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-11" target="arch-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-38" value="P3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1f6feb;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-11" target="arch-17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="962" y="300"/><mxPoint x="962" y="930"/></Array></mxGeometry></mxCell>
        <mxCell id="arch-39" value="P4 · C" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-9" target="arch-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="445"/><mxPoint x="500" y="1125"/></Array></mxGeometry></mxCell>
        <mxCell id="arch-40" value="P5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1f6feb;fontColor=#1f6feb;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-17" target="arch-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="997"/><mxPoint x="960" y="1050"/><mxPoint x="1440" y="1050"/><mxPoint x="1440" y="845"/></Array></mxGeometry></mxCell>
        <mxCell id="arch-41" value="Q1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-15" target="arch-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1564" y="625"/><mxPoint x="860" y="625"/></Array></mxGeometry></mxCell>
        <mxCell id="arch-42" value="Q2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-16" target="arch-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-43" value="Q3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-18" target="arch-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-44" value="Q4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-18" target="arch-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-45" value="Q4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-18" target="arch-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-46" value="DuckDB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-19" target="arch-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="1138"/></Array></mxGeometry></mxCell>
        <mxCell id="arch-47" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-20" target="arch-25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="1180"/></Array></mxGeometry></mxCell>
        <mxCell id="arch-48" value="Q5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-18" target="arch-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="arch-49" value="Q6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-16" target="arch-15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="640"/><mxPoint x="1440" y="640"/><mxPoint x="1440" y="248"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="query" name="Query path">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="query-1" value="&lt;b&gt;One query, step by step&lt;/b&gt;: GraphQL &lt;i&gt;rows(…){ claim(key) joined(…){ edge{claim} row{claim} } }&lt;/i&gt; or REST &lt;i&gt;…/queries/{q}:run&lt;/i&gt;, served by the QA task. Right column: where each step runs." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="50" as="geometry"/></mxCell>
        <mxCell id="query-2" value="&lt;b&gt;1 · Request arrives&lt;/b&gt;&lt;br&gt;Client → ALB → nginx → FastAPI on the QA task. GraphQL resolves field by field; the first item of a list to ask for a join or a claim answers it for the whole list." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-3" value="&lt;b&gt;network&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="94" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-4" value="&lt;b&gt;2 · Release and datasets&lt;/b&gt;&lt;br&gt;The collection's current release, then the datasets matching the anchor's dimensions (collection_releases, release_datasets, dataset_dimensions)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="192" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-5" value="&lt;b&gt;MySQL · 2 queries&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="206" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-2" target="query-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-7" value="&lt;b&gt;3 · Pick the store&lt;/b&gt;&lt;br&gt;Per dataset: a bucket index (dataset_indexes) → BucketStore; otherwise SqlStore. Answers are remembered in the process (indexes never change once recorded)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="304" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-8" value="&lt;b&gt;MySQL · cached&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="318" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-4" target="query-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-10" value="&lt;b&gt;4 · Anchor rows&lt;/b&gt;&lt;br&gt;Filter, order and limit one row kind across those datasets. On a cache miss the dataset's Parquet is read from the index bucket and checked against its sha256 first." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="416" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-11" value="&lt;b&gt;DuckDB over the cache · or SQL on result_rows · S3 on a miss&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="430" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-7" target="query-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-13" value="&lt;b&gt;5 · Joins&lt;/b&gt;&lt;br&gt;Follow an edge kind (e.g. member_of) to rows of another kind: one query per dataset for every anchor row, each keeping its own window." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="528" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-14" value="&lt;b&gt;DuckDB · or MySQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="542" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-10" target="query-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-16" value="&lt;b&gt;6 · Gene sets, up front&lt;/b&gt;&lt;br&gt;Every gene set the response will render (joined groups, rows about a gene set): label, member count and members, two queries per dataset." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-17" value="&lt;b&gt;DuckDB · or MySQL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="654" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-13" target="query-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-19" value="&lt;b&gt;7 · Render the claims&lt;/b&gt;&lt;br&gt;Mint contexts (template × result file) read once per request; each row's and group's claims rendered and checked against their DAPPER-ID-1 ids." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="752" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-20" value="&lt;b&gt;CPU (claim engine) + MySQL · 1–2 queries&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="766" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-16" target="query-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-22" value="&lt;b&gt;8 · Envelopes, in one batch&lt;/b&gt;&lt;br&gt;Claim rows, propositions, scores, evidence and value locators for every claim of the response; which referenced objects are stored." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="864" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-23" value="&lt;b&gt;MySQL · ~5 queries&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="878" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-19" target="query-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-25" value="&lt;b&gt;9 · Respond, then record&lt;/b&gt;&lt;br&gt;The response is sent; claims served for the first time are stored and every claim's assertion counter goes up (dapper_objects, result_claims, object_refs, object_text)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="976" width="1080" height="92" as="geometry"/></mxCell>
        <mxCell id="query-26" value="&lt;b&gt;MySQL · batched writes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingLeft=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="990" width="420" height="64" as="geometry"/></mxCell>
        <mxCell id="query-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;fontColor=#2e7d32;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="query-22" target="query-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="query-28" value="&lt;b&gt;Measured&lt;/b&gt; (local profile, 2026-11-25): REST top-genes-with-sets for IBD (10 genes × 3 gene sets, 148 claims): 1,114 database calls and 93 index queries before batching, 13 and 5 after. GraphQL rows with joins (70 claims): 325 and 57 before, 19 and 5 after. On QA, warm: ~1.2–1.9 s, most of it rendering claims on 0.5 vCPU; the first query after the task is replaced also fills the cache (planned: at startup)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1098" width="1530" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
