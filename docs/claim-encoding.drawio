        <!-- ===================== lane 2: gene-set association + entity layer ===================== -->
        <mxCell id="p2" value="&lt;b&gt;«Proposition» RESULT&lt;/b&gt;&lt;br&gt;subject_entity: &lt;b&gt;dapper:GeneSet.localf7d3fb63…&lt;/b&gt; (an ID, not a name)&lt;br&gt;relation: &lt;b&gt;associated_with&lt;/b&gt; · object_entity: &lt;b&gt;IBD&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;The gene set GEO_BULK__GSE195696__… is associated with IBD.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1">
