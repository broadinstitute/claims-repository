          <mxGeometry x="1360" y="470" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tiernote" value="&lt;b&gt;Interpretive layer on top (toolkit tier claims)&lt;/b&gt;&lt;br&gt;Each metric also gets a tier Claim: its own Proposition (BIOLOGICAL_INTERPRETATION, e.g. &quot;NOD2 is relevant to IBD&quot;) + direction, generated by a versioned rule Activity (gene-evidence-tiers v0.1.0). Its EvidenceItem points at the measurement claim via source_claims and reuses the &lt;b&gt;same ValueLocators&lt;/b&gt; (shared byte spans → shared content addresses). 64,963 tier claims for IBD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1360" y="610" width="380" height="170" as="geometry" />
