<mxfile host="claims-repository" modified="2026-11-09" agent="claude" version="24.0.0">
  <diagram id="claim-encoding" name="PIGEAN claim encoding">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1870" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== titles ===================== -->
        <mxCell id="t0" value="&lt;b&gt;How PIGEAN claims are encoded in dapper&lt;/b&gt; — one Claim per result-file row; the proposition carries the (subject, predicate, object); scores stay typed in has_score; evidence grounds every number at the file-byte boundary" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;1 · Gene–phenotype measurement claim&lt;/b&gt;&lt;br&gt;(one per combined_gene_stats.json row)" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;2 · Gene-set–phenotype claim + entity layer&lt;/b&gt;&lt;br&gt;(one per combined_gene_set_stats.json row)" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="50" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;3 · Membership claim (score-less)&lt;/b&gt;&lt;br&gt;(one per gene_gene_set_stats.json pair; 143,508 for IBD)" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="50" width="440" height="40" as="geometry" />
        </mxCell>

        <!-- ===================== lane 1: gene association ===================== -->
        <mxCell id="p1" value="&lt;b&gt;«Proposition» RESULT&lt;/b&gt;&lt;br&gt;subject_entity: &lt;b&gt;NOD2&lt;/b&gt;&lt;br&gt;relation: &lt;b&gt;associated_with&lt;/b&gt;&lt;br&gt;object_entity: &lt;b&gt;IBD&lt;/b&gt;&lt;br&gt;&lt;i&gt;&quot;The gene NOD2 is associated with IBD.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="100" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;«Claim» PIGEAN measurement&lt;/b&gt;&lt;br&gt;statement: &quot;PIGEAN assessed … (combined 6.53; log BF 3.45; prior 3.08)&quot;&lt;br&gt;source_locator: combined_gene_stats.json#gene=NOD2&lt;br&gt;&lt;i&gt;no direction — PIGEAN supplies no thresholded judgment&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="270" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;«ClaimScore» × 3&lt;/b&gt;&lt;br&gt;combined 6.53 · log_bf 3.45 · prior 3.08&lt;br&gt;score_kind SCORE + interpretation text&lt;br&gt;&lt;i&gt;typed &amp;amp; filterable — the query surface&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;«EvidenceItem» × 3&lt;/b&gt; (one per metric)&lt;br&gt;target_proposition ↑ · explanation&lt;br&gt;evidence_source: the result file&lt;br&gt;&lt;i&gt;&quot;the score is the evidence&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="450" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="&lt;b&gt;«ValueLocator» (PROPOSAL)&lt;/b&gt;&lt;br&gt;byte_start 13299 · byte_length 4&lt;br&gt;value_text &quot;6.53&quot; · selector gene=NOD2; key=combined&lt;br&gt;&lt;i&gt;file[start : start+len] == value_text&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="610" width="260" height="100" as="geometry" />
        </mxCell>
