        <mxCell id="s2" value="&lt;b&gt;«ClaimScore» × 2&lt;/b&gt;&lt;br&gt;beta (EFFECT_ESTIMATE, joint/corrected)&lt;br&gt;beta_uncorrected (marginal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1">
