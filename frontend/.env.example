# Claims admin console (Next.js). Server-side only: never prefix with NEXT_PUBLIC_.

# NextAuth: session encryption key (openssl rand -base64 48) and public URL.
AUTH_SECRET=''
NEXTAUTH_URL=http://localhost:3000

# The claims repository Google OAuth client. Its
# authorized redirect URIs must include <NEXTAUTH_URL>/api/auth/callback/google.
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''

# Approved admins: exact, case-insensitive, Google-verified emails.
ADMIN_EMAILS=chase@broadinstitute.org,cyakabos@broadinstitute.org

# The claims API and the secret it shares with this server (>= 32 chars).
# The API must have the same CLAIMS_ADMIN_GATEWAY_SECRET. ADMIN_EMAILS above is
# the only list of admins; the API accepts whoever this server signs in.
CLAIMS_API_URL=http://127.0.0.1:8100
CLAIMS_ADMIN_GATEWAY_SECRET=''

# Local development only (ignored by next build / next start and on Vercel):
# skip Google sign-in and act as ADMIN_DEV_EMAIL.
ADMIN_DEV_BYPASS=false
ADMIN_DEV_EMAIL=chase@broadinstitute.org
